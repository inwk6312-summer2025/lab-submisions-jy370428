[1161.664257, "o", "\u001b[1;1H\u001b[35mimport\u001b[m logging\r\n\u001b[35mimport\u001b[m requests\r\n\u001b[35mfrom\u001b[m requests.auth \u001b[35mimport\u001b[m HTTPBasicAuth\r\n\u001b[35mimport\u001b[m json\r\nlogging.basicConfig(level=logging.INFO, \u001b[36mformat\u001b[m=\u001b[31m'%(name)s - %(levelname)s - %(message)s'\u001b[m)\r\nHOST = \u001b[31m'192.168.1.101'\u001b[m\r\nUSER = \u001b[31m'student'\u001b[m\r\nPASS = \u001b[31m'Meilab123'\u001b[m\r\nBASE_URL = \u001b[31m'http://{0}/restconf/api/running/'\u001b[m.format(HOST)\r\n\u001b[38;5;130mdef\u001b[m \u001b[36mget_interfaces\u001b[m(append_url):\r\n    url = BASE_URL + append_url\r\n    auth = HTTPBasicAuth(USER, PASS)\r\n    headers = {\u001b[31m'Accept'\u001b[m: \u001b[31m'application/vnd.yang.data+json'\u001b[m}\u001b[15;5Hlogging.info(f\u001b[31m\"URL ==> {url}\"\u001b[m)\u001b[17;5Hresponse = requests.get(url, auth=auth, headers=headers)\r\n    \u001b[38;5;130mif\u001b[m response.status_code == \u001b[31m200\u001b[m:\u001b[19;9Hlogging.info(f\u001b[31m\"Request was successful on {HOST}, Code: {response.status_code}\"\u001b[m)\u001b[20;9H\u001b[38;5;130mreturn\u001b[m json.dumps(response.json(), sort_keys=\u001b[36mTrue\u001b[m, indent=\u001b[31m4\u001b[m )\r\n    \u001b[38;5;130melse\u001b[m:\u001b[22;9Hlogging.error(f\u001b[31m\"Error encountered d"]
[1161.665052, "o", "uring request on {HOST}, Code: {response.status_code}\"\u001b[m)\u001b[23;9H\u001b[38;5;130mreturn\u001b[m response.text\r\n\u001b[36mprint\u001b[m(get_interfaces(\u001b[31m'interfaces'\u001b[m))\r\n\u001b[94m~                                                                                                     \u001b[26;1H~                                                                                                     \u001b[27;1H~                                                                                                     \u001b[28;1H~                                                                                                     \u001b[29;1H~                                                                                                     \u001b[30;1H~                                                                                                     \u001b[31;1H~                                                                                                     \u001b[32;1H~                                                                                                    "]
