[4061.177663, "o", "\u001b[?25l\u001b[95m23'\u001b[m\u001b[13;1H\u001b[K\u001b[14;1H\u001b[96m# Read YAML file\u001b[m\u001b[14;17H\u001b[K\u001b[15;1H\u001b[93mwith\u001b[m \u001b[1m\u001b[96mopen\u001b[m(\u001b[95m'routers.yaml'\u001b[m, \u001b[95m'r'\u001b[m) \u001b[93mas\u001b[m f:\u001b[15;37H\u001b[K\u001b[16;1H    r\u001b[16;6H\u001b[K\u001b[16;6H\u001b[?25h"]
