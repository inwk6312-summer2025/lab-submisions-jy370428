[3527.53109, "o", "\u001b[33mcommit b4e69516d8e57111137e1e744f11e868fdc118ff\u001b[m\u001b[33m (\u001b[m\u001b[1;36mHEAD -> \u001b[m\u001b[1;32mv1\u001b[m\u001b[33m, \u001b[m\u001b[1;31morigin/v1\u001b[m\u001b[33m)\u001b[m\u001b[m"]
[3527.531828, "o", "\r\n"]
[3527.532118, "o", "Author: Tito <tito@dal.ca>\u001b[m\r\n"]
[3527.532919, "o", "Date:   Sat Jan 15 12:31:38 2022 -0400\u001b[m\r\n\u001b[m\r\n    Added Dockerfile and app folder\u001b[m\r\n\u001b[m\r\n\u001b[1mdiff --git a/Dockerfile b/Dockerfile\u001b[m\u001b[m\r\n\u001b[1mnew file mode 100644\u001b[m\u001b[m\r\n\u001b[1mindex 0000000..14fbeee\u001b[m\u001b[m\r\n\u001b[1m--- /dev/null\u001b[m\u001b[m\r\n\u001b[1m+++ b/Dockerfile\u001b[m\u001b[m\r\n\u001b[36m@@ -0,0 +1,7 @@\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mFROM python:3.5\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mRUN pip install Flask==0.11.1\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mRUN useradd -ms /bin/bash admin\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mUSER admin\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mWORKDIR /app\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mCOPY app /app\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mCMD [\"python\", \"app.py\"]\u001b[m\u001b[41m \u001b[m\u001b[m\r\n\u001b[1mdiff --git a/app/app.py b/app/app.py\u001b[m\u001b[m\r\n\u001b[1mnew file mode 100644\u001b[m\u001b[m\r\n\u001b[1mindex 0000000..9b2983f\u001b[m\u001b[m\r\n\u001b[1m--- /dev/null\u001b[m\u001b[m\r\n\u001b[1m+++ b/app/app.py\u001b[m\u001b[m\r\n\u001b[36m@@ -0,0 +1,9 @@\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mfrom flask import Flask\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mapp = Flask(__name__)\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m@app.route('/')\u001b[m\u001b[m"]
[3527.533265, "o", "\r\n\u001b[32m+\u001b[m\u001b[32mdef hello_world():\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    return 'Hello, World!'\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mif __name__ == '__main__':\u001b[m\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    app.run(host='0.0.0.0')\u001b[m\u001b[m\r\n"]
