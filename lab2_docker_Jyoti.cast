[2921.129487, "o", "\u001b[?25lnk port\r\n\u001b[1m\u001b[96muplink\u001b[m\u001b[38;5;224m:\u001b[m \u001b[95mtrue\u001b[m\u001b[4;13H\u001b[K\u001b[5;1H\u001b[93m- \u001b[m\u001b[1m\u001b[96mname\u001b[m\u001b[38;5;224m:\u001b[m GigabitEthernet0/2\u001b[5;27H\u001b[K\u001b[6;1Hdes\u001b[6;4H\u001b[K\u001b[6;4H\u001b[?25h"]
[2921.136517, "o", "\u001b[?25l\r\u001b[1m\u001b[96mdesc\u001b[m\u001b[38;5;224m:\u001b[m Server port number one\r\n\u001b[1m\u001b[96mvlan\u001b[m\u001b[38;5;224m:\u001b[m \u001b[95m10\u001b[m\u001b[7;9H\u001b[K\u001b[8;1H\u001b[93m- \u001b[m\u001b[1m\u001b[96mname\u001b[m\u001b[38;5;224m:\u001b[m GigabitEther\u001b[8;21H\u001b[K\u001b[8;21H\u001b[?25h"]
[2921.144316, "o", "\u001b[?25lnet0/3\r\n\u001b[1m\u001b[96mdesc\u001b[m\u001b[38;5;224m:\u001b[m Server port number two\u001b[9;29H\u001b[K\u001b[10;1H\u001b[1m\u001b[96mvlan\u001b[m\u001b[38;5;224m:\u001b[m \u001b[95m10\u001b[m\u001b[10;9H\u001b[K\u001b[11;1H\u001b[1m\u001b[96mtask7.py\u001b[m\u001b[38;5;224m :\u001b[m\u001b[11;11H\u001b[K\u001b[12;1Hfr\u001b[12;3H\u001b[K\u001b[12;3H\u001b[?25h"]
[2921.152977, "o", "\u001b[?25lom jinja2 import Environment, FileSystemLoader\r\nimport yaml\u001b[13;12H\u001b[K\u001b[14;1H\u001b[K\u001b[14;1H\u001b[?25h"]
[2921.157524, "o", "\u001b[?25lENV = Environment(loader=FileSystemLoader('.'))\r\ntemplate = EN\u001b[15;14H\u001b[K\u001b[15;14H\u001b[?25h"]
[2921.16252, "o", "\u001b[?25lV.get_template(\"template-task6.j2\")\r\nwith open(\"data-task7.yml\u001b[16;26H\u001b[K\u001b[16;26H\u001b[?25h"]
[2921.172395, "o", "\u001b[?25l\r\u001b[1m\u001b[96mwith open(\"data-task7.yml\") as f\u001b[m\u001b[38;5;224m:\u001b[m\r\ninterfaces = yaml.load(f, Loader=yaml.SafeLoader)\u001b[17;50H\u001b[K\u001b[18;1Hpri\u001b[18;4H\u001b[K\u001b[18;4H\u001b[?25h"]
[2921.177432, "o", "\u001b[?25lnt(template.render(interface_list=interfaces))\r\nWe will reuse t\u001b[19;16H\u001b[K\u001b[19;16H\u001b[?25h"]
[2921.182929, "o", "\u001b[?25lhe same template we previously created in Task6 and achieve the\u001b[?25h"]
[2921.193993, "o", "\u001b[?25l same result—\u001b[19;93Hbut this\r\ntime, the data that we’\u001b[20;24Hre using to p\u001b[20;37H\u001b[K\u001b[20;37H\u001b[?25h"]
[2921.200976, "o", "\u001b[?25lopulate our template comes from an external YAML file, which \u001b[?25h"]
[2921.211654, "o", "\u001b[?25lis eaa\u001b[21;1Hsier\u001b[21;5H\u001b[K\u001b[22;1Hfor everyone to maintain. The Python file now only c\u001b[22;53H\u001b[K\u001b[22;53H\u001b[?25h"]
[2921.219517, "o", "\u001b[?25lontains the logic of pulling in data and renderingg\u001b[23;1H a\u001b[23;3H\u001b[K\u001b[24;1Htemplate.\u001b[24;10H\u001b[K\u001b[24;10H\u001b[?25h"]
[2921.228441, "o", "\u001b[?25l This makes for a more maintainable template rendering system.\u001b[25;1H\u001b[K\u001b[25;1H\u001b[?25h"]
[2921.233366, "o", "\u001b[?25lJinja Filters\r\nVariables can be modified by filters. Filters are\u001b[26;50H\u001b[K\u001b[26;50H\u001b[?25h"]
[2921.240947, "o", "\u001b[?25l separated from the variable by a pipe symbol (|) andd\u001b[27;1H may\u001b[27;5H\u001b[K\u001b[28;1Hhave \u001b[28;6H\u001b[K\u001b[28;6H\u001b[?25h"]
[2921.250144, "o", "\u001b[?25loptional arguments in parentheses. Multiple filters can be chai\u001b[?25h"]
[2921.260106, "o", "\u001b[?25lned. The output of one filter is aa\u001b[29;1Hpplied\u001b[29;7H\u001b[K\u001b[30;1Hto the next.\u001b[30;13H\u001b[K\u001b[31;1HFor examp\u001b[31;10H\u001b[K\u001b[31;10H\u001b[?25h"]
[2921.265762, "o", "\u001b[?25lle, \u001b[38;5;224m{{\u001b[m name|striptags|title \u001b[38;5;224m}}\u001b[m will remove all HTML Tags from v\u001b[?25h"]
[2921.27992, "o", "\u001b[?25lariable name and title-\r\ncase the output just like a python func\u001b[32;40H\u001b[K\u001b[32;40H\u001b[?25h"]
[2921.28703, "o", "\u001b[?25ltion call →\u001b[32;52Htitle(striptags(name)).\r\nFilters that accept argum\u001b[33;26H\u001b[K\u001b[33;26H\u001b[?25h"]
[2921.293075, "o", "\u001b[?25lents have parentheses around the arguments, just like a functio\u001b[?25h"]
[2921.308027, "o", "\u001b[?25ln call. For\r\n\u001b[1m\u001b[96mexample\u001b[m\u001b[38;5;224m:\u001b[m \u001b[38;5;224m{{\u001b[m listx|join(', \u001b[95m') }} will join a list wi\u001b[m\u001b[34;52H\u001b[K\u001b[34;52H\u001b[?25h"]
[2921.316657, "o", "\u001b[?25l\u001b[95mth commas just like a python function call →\u001b[35;1Hstr.join('\u001b[m, \u001b[95m', l\u001b[m\u001b[35;17H\u001b[K\u001b[35;17H\u001b[?25h"]
[2921.321749, "o", "\u001b[?25l\u001b[95mistx).\r\nHere'\u001b[m\u001b[1m\u001b[96ms an example showing a simple filter in action\u001b[m\u001b[38;5;224m:\u001b[m\u001b[36;53H\u001b[K\u001b[37;1HTem\u001b[37;4H\u001b[K\u001b[37;4H\u001b[?25h"]
[2921.331506, "o", "\u001b[?25l\r\u001b[1m\u001b[96mTemplate\u001b[m\u001b[38;5;224m:\u001b[m\r\n\u001b[1m\u001b[96mFirst name\u001b[m\u001b[38;5;224m:\u001b[m \u001b[38;5;224m{{\u001b[m first_name | capitalize \u001b[38;5;224m}}\u001b[m\u001b[38;42H\u001b[K\u001b[39;1H\u001b[1m\u001b[96mData\u001b[m\u001b[38;5;224m:\u001b[m\u001b[39;6H\u001b[K\u001b[40;1Hfirst_na\u001b[40;9H\u001b[K\u001b[40;9H\u001b[?25h"]
[2921.337445, "o", "\u001b[?25l\r\u001b[1m\u001b[96mfirst_name\u001b[m\u001b[38;5;224m:\u001b[m pythonClass\r\n\u001b[1m\u001b[96mResult\u001b[m\u001b[38;5;224m:\u001b[m\u001b[41;8H\u001b[K\u001b[42;1H\u001b[1m\u001b[96mFirst name\u001b[m\u001b[38;5;224m:\u001b[m PythonClass\u001b[42;24H\u001b[K\u001b[43;1H\u001b[K\u001b[51;86H9,1\u001b[43;1H\u001b[?25h"]
[2925.041288, "o", "\u001b[?25l\u001b[38;5;81m^Z\u001b[m\u001b[51;88H2-3\u001b[43;3H\u001b[?25h"]
