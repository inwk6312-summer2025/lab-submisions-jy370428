[4599.901976, "o", "\u001b[1;1H\u001b[35mfrom\u001b[m netmiko \u001b[35mimport\u001b[m Netmiko\r\n\r\ndevices = [\r\n    {\u001b[5;9H\u001b[31m\"device_type\"\u001b[m: \u001b[31m\"cisco_ios\"\u001b[m,\u001b[6;9H\u001b[31m\"ip\"\u001b[m: \u001b[31m\"192.168.1.106\"\u001b[m,\u001b[7;9H\u001b[31m\"username\"\u001b[m: \u001b[31m\"student\"\u001b[m,\u001b[8;9H\u001b[31m\"password\"\u001b[m: \u001b[31m\"Meilab123\"\u001b[m,\u001b[9;9H\u001b[31m\"port\"\u001b[m: \u001b[31m\"22\"\u001b[m},\r\n    {\u001b[11;9H\u001b[31m\"device_type\"\u001b[m: \u001b[31m\"cisco_ios\"\u001b[m,\u001b[12;9H\u001b[31m\"ip\"\u001b[m: \u001b[31m\"192.168.1.107\"\u001b[m,\u001b[13;9H\u001b[31m\"username\"\u001b[m: \u001b[31m\"student\"\u001b[m,\u001b[14;9H\u001b[31m\"password\"\u001b[m: \u001b[31m\"Meilab123\"\u001b[m,\u001b[15;9H\u001b[31m\"port\"\u001b[m: \u001b[31m\"22\"\u001b[m},\r\n    {\u001b[17;9H\u001b[31m\"device_type\"\u001b[m: \u001b[31m\"cisco_ios\"\u001b[m,\u001b[18;9H\u001b[31m\"ip\"\u001b[m: \u001b[31m\"192.168.1.108\"\u001b[m,\u001b[19;9H\u001b[31m\"username\"\u001b[m: \u001b[31m\"student\"\u001b[m,\u001b[20;9H\u001b[31m\"password\"\u001b[m: \u001b[31m\"Meilab123\"\u001b[m,\u001b[21;9H\u001b[31m\"port\"\u001b[m: \u001b[31m\"22\"\u001b[m},\r\n    {\u001b[23;9H\u001b[31m\"device_type\"\u001b[m: \u001b[31m\"cisco_ios\"\u001b[m,\u001b[24;9H\u001b[31m\"ip\"\u001b[m: \u001b[31m\"192.168.1.109\"\u001b[m,\u001b[25;9H\u001b[31m\"username\"\u001b[m: \u001b[31m\"student\"\u001b[m,\u001b[26;9H\u001b[31m\"password\"\u001b[m: \u001b[31m\"Meilab123\"\u001b[m,\u001b[27;9H\u001b[31m\"port\"\u001b[m: \u001b[31m\"22\"\u001b[m}\r\n]\r\n\r\n\u001b[38;5;130mfor\u001b[m device \u001b[38;5;130"]
[4599.902418, "o", "min\u001b[m devices:\r\n    net_connect = Netmiko(**device)\r\n    \u001b[36mprint\u001b[m(f\u001b[31m\"Default prompt: {net_connect.find_prompt()}\"\u001b[m)\r\n    net_connect.send_command_timing(\u001b[31m\"disable\"\u001b[m)\r\n    \u001b[36mprint\u001b[m(f\u001b[31m\"Disable command: {net_connect.find_prompt()}\"\u001b[m)\r\n    net_connect.enable()\r\n    \u001b[36mprint\u001b[m(f\u001b[31m\"Enable command: {net_connect.find_prompt()}\"\u001b[m)\r\n\u001b[94m~                                                                                                     \u001b[38;1H~                                                                                                     \u001b[39;1H~                                                                                                     \u001b[40;1H~                                                                                                     \u001b[41;1H~                                                                                                     \u001b[42;1H~                                                                                                     "]
