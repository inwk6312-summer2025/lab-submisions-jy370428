[3878.09233, "o", "\u001b[27m\u001b[23m\u001b[29m\u001b[m\u001b[H\u001b[2J\u001b[?25l\u001b[1;1H\u001b[96m# import Jinja2 library and PyYAML\u001b[m\r\n\u001b[38;5;81mfrom\u001b[m jinja2 \u001b[38;5;81mimport\u001b[m Environment, FileSystemLoader\r\n\u001b[38;5;81mimport\u001b[m yaml\r\n\r\n\u001b[96m# Declare template environment\u001b[m\r\nENV = Environment(loader=FileSystemLoader(\u001b[95m'.'\u001b[m))\r\n\u001b[93mdef\u001b[m \u001b[1m\u001b[96mget_interface_speed\u001b[m(interface_name):\r\n    \u001b[95m\"\"\" get_interface_speed returns the default Mbps value for a given\r\n    network interface by looking for certain keywords in the name\r\n    \"\"\"\u001b[m\r\n    \u001b[93mif\u001b[m \u001b[95m'gigabit'\u001b[m \u001b[93min\u001b[m interface_name.lower():\u001b[12;9H\u001b[93mreturn\u001b[m \u001b[95m1000\u001b[m\r\n    \u001b[93mif\u001b[m \u001b[95m'fast'\u001b[m \u001b[93min\u001b[m interface_name.lower():\r\n    \u001b[93mreturn\u001b[m \u001b[95m100\u001b[m\r\n\u001b[96m# Filters are added to the ENV object after declaration. Note that we're\r\n# actually passing in our \"get_interface_speed\" function and not running\r\n# it--the template engine will execute this function when we call\r\n# template.render()\u001b[m\r\n\r\nENV.filters[\u001b[95m'get_interface_speed'\u001b[m] = get_interface_speed\r\ntemplate = "]
